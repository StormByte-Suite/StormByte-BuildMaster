cmake_minimum_required(VERSION 3.21)
if(NOT DEFINED BM_ROOT OR NOT DEFINED WORK_DIR OR NOT DEFINED GENERATOR)
	message(FATAL_ERROR "stamp-lifecycle: BM_ROOT, WORK_DIR and GENERATOR are required")
endif()
if(NOT DEFINED BACKEND)
	set(BACKEND cmake)
endif()

function(run)
	execute_process(COMMAND ${ARGV}
		RESULT_VARIABLE _rc OUTPUT_VARIABLE _out ERROR_VARIABLE _err)
	file(APPEND "${_root}/commands.log" "${ARGV}\n${_out}\n${_err}\nexit=${_rc}\n")
	if(NOT _rc EQUAL 0)
		message(FATAL_ERROR "stamp-lifecycle: ${ARGV} failed (${_rc})\n${_out}\n${_err}")
	endif()
endfunction()

string(RANDOM LENGTH 8 ALPHABET 0123456789abcdef _run)
set(_root "${WORK_DIR}/${_run}")
set(_src "${_root}/src")
set(_bin "${_root}/build")
file(MAKE_DIRECTORY "${_src}")
file(COPY "${CMAKE_CURRENT_LIST_DIR}/CMakeLists.txt"
	"${CMAKE_CURRENT_LIST_DIR}/consumer"
	"${CMAKE_CURRENT_LIST_DIR}/upstream" DESTINATION "${_src}")
set(_configure "${CMAKE_COMMAND}" -S "${_src}" -B "${_bin}" -G "${GENERATOR}"
	"-DBM_ROOT=${BM_ROOT}" "-DBACKEND=${BACKEND}" -DCMAKE_BUILD_TYPE=Release
	"-DCMAKE_C_COMPILER=${C_COMPILER}" "-DCMAKE_CXX_COMPILER=${CXX_COMPILER}")
run(${_configure})
include("${_bin}/paths.cmake")
set(_build "${CMAKE_COMMAND}" --build "${_bin}" --parallel 32)
set(_static "${LIBDIR}/liblifecycle-static.a")
set(_shared "${LIBDIR}/liblifecycle-shared.so")
set(_soname "${_shared}.1")
set(_real "${_shared}.1.0")
set(_header "${PREFIX}/include/lifecycle/header.h")

function(check_products)
	foreach(_path IN ITEMS "${_static}" "${_shared}" "${_soname}" "${_real}" "${_header}")
		if(NOT EXISTS "${_path}")
			message(FATAL_ERROR "stamp-lifecycle: missing ${_path}")
		endif()
	endforeach()
	if(NOT IS_SYMLINK "${_shared}" OR NOT IS_SYMLINK "${_soname}")
		message(FATAL_ERROR "stamp-lifecycle: shared-library symlinks were not preserved")
	endif()
	run("${_bin}/consumer/lifecycle-check")
endfunction()

function(check_unchanged _installs)
	foreach(_mode static shared headers)
		set(_bd "${BD_${_mode}}")
		if(DEFINED _built_${_mode})
			if(NOT EXISTS "${_bd}/.ninja_log")
				message(FATAL_ERROR "stamp-lifecycle: ${_mode} build log disappeared")
			endif()
			file(SHA256 "${_bd}/.ninja_log" _hash)
			if(NOT _hash STREQUAL _built_${_mode})
				message(FATAL_ERROR "stamp-lifecycle: ${_mode} was rebuilt")
			endif()
		endif()
		if(_installs)
			file(SHA256 "${_bd}/install-count.txt" _hash)
			if(NOT _hash STREQUAL _installed_${_mode})
				message(FATAL_ERROR "stamp-lifecycle: ${_mode} was unnecessarily installed")
			endif()
		endif()
	endforeach()
endfunction()

run(${_build})
check_products()
file(TIMESTAMP "${_bin}/consumer/libconsumer.so" _consumer_time "%s")
file(TIMESTAMP "${_bin}/consumer/lifecycle-check" _exe_time "%s")
run("${CMAKE_COMMAND}" -E sleep 1)
foreach(_mode static shared headers)
	set(_bd "${BD_${_mode}}")
	if(EXISTS "${_bd}/.ninja_log")
		file(SHA256 "${_bd}/.ninja_log" _built_${_mode})
	endif()
	file(SHA256 "${_bd}/install-count.txt" _installed_${_mode})
endforeach()
message(STATUS "stamp-lifecycle: initial build passed (${BACKEND}, ${GENERATOR})")

run(${_build})
check_products()
check_unchanged(TRUE)
file(TIMESTAMP "${_bin}/consumer/libconsumer.so" _consumer_after "%s")
file(TIMESTAMP "${_bin}/consumer/lifecycle-check" _exe_after "%s")
if(NOT _consumer_time STREQUAL _consumer_after OR NOT _exe_time STREQUAL _exe_after)
	message(FATAL_ERROR "stamp-lifecycle: unchanged consumer was relinked")
endif()
message(STATUS "stamp-lifecycle: unchanged build is a no-op")

run(${_build} --clean-first)
check_products()
check_unchanged(FALSE)
message(STATUS "stamp-lifecycle: clean-first restored products without recompilation")

foreach(_missing IN ITEMS "${_static}" "${_shared}" "${_soname}" "${_real}" "${_header}")
	file(REMOVE "${_missing}")
	run(${_build})
	check_products()
	check_unchanged(FALSE)
endforeach()
message(STATUS "stamp-lifecycle: selectively deleted archives, symlinks, shared objects and headers restored")

run("${CMAKE_COMMAND}" --build "${_bin}" --target clean)
if(EXISTS "${_static}" OR EXISTS "${_shared}")
	message(FATAL_ERROR "stamp-lifecycle: clean did not remove declared install byproducts")
endif()
if(NOT EXISTS "${BD_static}/liblifecycle-static.a"
		OR NOT EXISTS "${BD_shared}/liblifecycle-shared.so.1.0")
	message(FATAL_ERROR "stamp-lifecycle: clean unexpectedly removed nested build products")
endif()
run(${_configure})
run(${_build})
check_products()
check_unchanged(FALSE)
message(STATUS "stamp-lifecycle: reconfigure after clean passed")

# Upgrade old, digest-only stamps without discarding a valid nested build tree.
foreach(_mode static shared headers)
	file(REMOVE "${BD_${_mode}}/bm-stamp.build"
		"${BD_${_mode}}/bm-stamp.build-files"
		"${BD_${_mode}}/bm-stamp.install-files")
endforeach()
run(${_configure})
run(${_build})
check_products()
check_unchanged(FALSE)
message(STATUS "stamp-lifecycle: legacy stamps migrated without recompilation")

# A build-only request must not make an old installation look current.
run("${CMAKE_COMMAND}" -E sleep 1)
file(WRITE "${_src}/upstream/value.c"
	"int VALUE_FUNCTION(void) { return 11; }\n")
file(WRITE "${_src}/consumer/main.c"
	"int lifecycle_value(void);\nint main(void) { return lifecycle_value() == 25 ? 0 : 1; }\n")
run("${CMAKE_COMMAND}" --build "${_bin}" --target lifecycle-static_build)
run(${_build})
check_products()
message(STATUS "stamp-lifecycle: changed sources were built AND installed")

if(NOT EXISTS "${BD_static}/liblifecycle-static.a")
	message(FATAL_ERROR "stamp-lifecycle: nested static output was not found")
endif()
file(REMOVE "${BD_static}/liblifecycle-static.a")
run(${_build})
check_products()
message(STATUS "stamp-lifecycle: deleted nested build output was rebuilt")
