if(NOT INPUTS OR NOT CMAKE_AR OR NOT BUILDMASTER_SRCDIR OR NOT WORK_DIR)
	message(FATAL_ERROR "check_roundtrip: INPUTS, CMAKE_AR, BUILDMASTER_SRCDIR and WORK_DIR are required")
endif()

string(REPLACE "," ";" _source_inputs "${INPUTS}")
list(LENGTH _source_inputs _input_count)
if(_input_count LESS 3)
	message(FATAL_ERROR "check_roundtrip: expected publisher plus two static members")
endif()

file(REMOVE_RECURSE "${WORK_DIR}")
file(MAKE_DIRECTORY "${WORK_DIR}")
set(_inputs "${_source_inputs}")
foreach(_input IN LISTS _inputs)
	if(NOT EXISTS "${_input}")
		message(FATAL_ERROR "check_roundtrip: missing input ${_input}")
	endif()
endforeach()
string(REPLACE ";" "," _test_inputs "${_inputs}")
set(_worker "${BUILDMASTER_SRCDIR}/component/bundle/merge_static_archives.cmake")
set(_archive_suffix ".a")
if(WIN32)
	set(_archive_suffix ".lib")
endif()
set(_output "${WORK_DIR}/merged${_archive_suffix}")
set(_stamp "${WORK_DIR}/merged.stamp")

function(_bm_roundtrip_merge output inputs stamp)
	set(_args
		"-DOUTPUT=${output}"
		"-DINPUTS=${inputs}"
		"-DCMAKE_AR=${CMAKE_AR}"
		"-DBUILDMASTER_SRCDIR=${BUILDMASTER_SRCDIR}")
	if(NOT "${stamp}" STREQUAL "")
		list(APPEND _args "-DSTAMP_FILE=${stamp}")
	endif()
	execute_process(
		COMMAND "${CMAKE_COMMAND}" ${_args} -P "${_worker}"
		RESULT_VARIABLE _rc
		OUTPUT_VARIABLE _stdout
		ERROR_VARIABLE _stderr)
	if(NOT _rc EQUAL 0)
		message(FATAL_ERROR "check_roundtrip: merge failed (${_rc})\n${_stdout}\n${_stderr}")
	endif()
endfunction()

list(GET _inputs 1 _member_a)
list(GET _inputs 2 _member_b)
set(_modified_member "${WORK_DIR}/modified-member${_archive_suffix}")
set(_replacement_member "${WORK_DIR}/replacement-member${_archive_suffix}")
string(REPLACE ";" "," _member_pair "${_member_a};${_member_b}")
_bm_roundtrip_merge("${_modified_member}" "${_member_pair}" "")
set(_test_input_list "${_inputs}")
list(REMOVE_AT _test_input_list 2)
list(APPEND _test_input_list "${_modified_member}")
string(REPLACE ";" "," _test_inputs "${_test_input_list}")

_bm_roundtrip_merge("${_output}" "${_test_inputs}" "${_stamp}")
file(SHA256 "${_output}" _initial_hash)
_bm_roundtrip_merge("${_output}" "${_test_inputs}" "${_stamp}")
file(SHA256 "${_output}" _noop_hash)
if(NOT _initial_hash STREQUAL _noop_hash)
	message(FATAL_ERROR "check_roundtrip: no-op merge changed the archive")
endif()

_bm_roundtrip_merge("${_replacement_member}" "${_member_a}" "")
file(RENAME "${_replacement_member}" "${_modified_member}" RESULT _replace_result)
if(NOT _replace_result STREQUAL "0")
	message(FATAL_ERROR "check_roundtrip: could not replace changed member: ${_replace_result}")
endif()
file(SHA256 "${_output}" _before_member_change)
_bm_roundtrip_merge("${_output}" "${_test_inputs}" "${_stamp}")
file(SHA256 "${_output}" _after_member_change)
if(_before_member_change STREQUAL _after_member_change)
	message(FATAL_ERROR "check_roundtrip: changed member archive did not invalidate the merge")
endif()
_bm_roundtrip_merge("${_replacement_member}" "${_member_pair}" "")
file(RENAME "${_replacement_member}" "${_modified_member}" RESULT _replace_result)
if(NOT _replace_result STREQUAL "0")
	message(FATAL_ERROR "check_roundtrip: could not restore member archive: ${_replace_result}")
endif()
_bm_roundtrip_merge("${_output}" "${_test_inputs}" "${_stamp}")

file(REMOVE "${_output}")
_bm_roundtrip_merge("${_output}" "${_test_inputs}" "${_stamp}")
if(NOT EXISTS "${_output}")
	message(FATAL_ERROR "check_roundtrip: deleted output was not regenerated")
endif()

file(WRITE "${_output}" "corrupted")
file(WRITE "${_output}.part" "interrupted")
_bm_roundtrip_merge("${_output}" "${_test_inputs}" "${_stamp}")
if(NOT EXISTS "${_output}" OR EXISTS "${_output}.part")
	message(FATAL_ERROR "check_roundtrip: interrupted merge did not recover cleanly")
endif()

message(STATUS "REPACK roundtrip: no-op, member change, deleted/corrupt output and stale partial archive passed")