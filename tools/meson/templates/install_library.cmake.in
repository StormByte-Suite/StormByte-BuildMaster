# NOINSTALL (_BM_BUILDONLY=1): skip meson install; oficios still run
# under BUILDDIR. @_BM_INSTALL_RULES@ has no feature-flag ifs.

include("@BUILDMASTER_SRCDIR@/log.cmake")
if(COMMAND _bm_log_level_init)
	_bm_log_level_init()
endif()

if(EXISTS "@BUILDMASTER_FAIL_MARKER@")
	_bm_log_message(MESON STATUS "Skipped @_MESON_COMPONENT_TITLE@")
	_bm_log_message(MESON FATAL "Skipped @_MESON_COMPONENT_TITLE@")
endif()

include("@BUILDMASTER_SRCDIR@/component/stamp/gate.cmake")
set(BM_STAMP_REQUIRED_OUTPUTS "@_BM_STAMP_OUTPUTS@")
if(NOT "@_BM_PC_OUT@" STREQUAL "")
	list(APPEND BM_STAMP_REQUIRED_OUTPUTS "@_BM_PC_OUT@")
endif()
set(BM_STAMP_BUILDONLY "@_BM_BUILDONLY@")
set(BM_STAMP_INSTALL_MANIFEST "@_MESON_BUILD_DIR@/meson-logs/install-log.txt")
_bm_stamp_enter(
	"@_BM_STAMP_ID@"
	"install"
	"@_BM_STAMP_SRCDIR@"
	"@_BM_STAMP_BUILDDIR@"
	"@_BM_STAMP_EXTRA@"
	"@_BM_STAMP_WORKDIR@"
	"@_BM_STAMP_PATCHES@"
	"@_BM_STAMP_HOLDERS@"
	"@_BM_STAMP_ENV@")
if(BM_STAMP_SKIP)
	if(NOT "@_BM_REPACK_SCRIPT@" STREQUAL "")
		if(EXISTS "@_BM_REPACK_PUBLISHER_COPY@")
			if(NOT EXISTS "@_BM_REPACK_SCRIPT@")
				_bm_log_message(MESON FATAL
					"REPACK recipe missing: @_BM_REPACK_SCRIPT@")
			endif()
			include("@_BM_REPACK_SCRIPT@")
			return()
		endif()
	else()
		return()
	endif()
endif()

if("$ENV{BUILDMASTER_SILENT_RUNNER}" STREQUAL "1")
	_bm_log_message(NINJA STATUS
		"Installing @_MESON_COMPONENT_TITLE@")
endif()

if(NOT "@_BM_BUILDONLY@" STREQUAL "1")
	execute_process(
		COMMAND @_MESON_SILENT_CMD_PREFIX@ install --no-rebuild -C "@_MESON_BUILD_DIR@"
		WORKING_DIRECTORY "@_MESON_BUILD_DIR@"
		RESULT_VARIABLE _BM_STAGE_RC
	)

	if(NOT _BM_STAGE_RC EQUAL 0)
		if("@BUILDMASTER_FAIL_FAST@" STREQUAL "ON")
			file(MAKE_DIRECTORY "@BUILDMASTER_MARKERS_DIR@")
			file(WRITE "@BUILDMASTER_FAIL_MARKER@" "@_MESON_COMPONENT_SAFE@\n")
			file(WRITE "@BUILDMASTER_MARKERS_DIR@/@_MESON_COMPONENT_SAFE@.failed" "")
		endif()
		_bm_log_message(MESON FATAL
			"Installing @_MESON_COMPONENT_TITLE@ failed (exit ${_BM_STAGE_RC})")
	endif()
endif()

if("@_BM_INSTALL_RULES@" STREQUAL "")
	_bm_log_message(MESON FATAL
		"Install rules path empty for @_MESON_COMPONENT_TITLE@")
endif()
if(NOT EXISTS "@_BM_INSTALL_RULES@")
	_bm_log_message(MESON FATAL
		"Install rules missing for @_MESON_COMPONENT_TITLE@: @_BM_INSTALL_RULES@")
endif()
include("@_BM_INSTALL_RULES@")
if(NOT "@_BM_REPACK_PUBLISHER_COPY@" STREQUAL "")
	if(NOT EXISTS "@_BM_REPACK_PUBLISHER_SOURCE@")
		_bm_log_message(MESON FATAL
			"REPACK publisher archive missing: @_BM_REPACK_PUBLISHER_SOURCE@")
	endif()
	get_filename_component(_bm_repack_dir
		"@_BM_REPACK_PUBLISHER_COPY@" DIRECTORY)
	file(MAKE_DIRECTORY "${_bm_repack_dir}")
	file(COPY_FILE "@_BM_REPACK_PUBLISHER_SOURCE@"
		"@_BM_REPACK_PUBLISHER_COPY@" ONLY_IF_DIFFERENT)
endif()
if(NOT "@_BM_REPACK_SCRIPT@" STREQUAL "")
	if(NOT EXISTS "@_BM_REPACK_SCRIPT@")
		_bm_log_message(MESON FATAL
			"REPACK recipe missing: @_BM_REPACK_SCRIPT@")
	endif()
	include("@_BM_REPACK_SCRIPT@")
endif()
_bm_stamp_leave(create)
